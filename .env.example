# =====================================================================
# Configuration de l'assistant pédagogique
# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# =====================================================================

# --- Django ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True en développement uniquement
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production : décommenter la ligne suivante (voir config/settings_production.py)
# DJANGO_SETTINGS_MODULE=config.settings_production
# Production servie en HTTPS (cookies sécurisés, redirection, HSTS)
DJANGO_HTTPS=False
DJANGO_HSTS_SECONDS=3600
# Derrière un reverse proxy qui termine le HTTPS (nginx, Caddy)
DJANGO_BEHIND_PROXY=False
# Origines autorisées pour les formulaires en HTTPS, ex. https://assistant.exemple.tn
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL (avec l'extension pgvector) ---
DB_NAME=educational_assistant
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- LLM (quiz et chatbot) : ollama | gemini | anthropic ---
LLM_PROVIDER=ollama
# Inutile pour Ollama ; obligatoire pour Gemini et Anthropic
LLM_API_KEY=
LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://localhost:11434
# Délai maximal d'une réponse du LLM, en secondes (un petit modèle local est lent)
LLM_TIMEOUT=300
# Taille du contexte demandée à Ollama (en tokens)
LLM_NUM_CTX=8192

# --- Résumés : extractive (rapide, sans modèle) | huggingface ---
SUMMARY_PROVIDER=extractive
SUMMARY_MODEL_NAME=csebuetnlp/mT5_multilingual_XLSum

# --- Embeddings et recherche ---
# Changer de modèle impose de réindexer : python manage.py index_documents --force
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# Poids de BM25 dans la fusion RRF (0 = recherche vectorielle seule)
RETRIEVAL_LEXICAL_WEIGHT=1
RETRIEVAL_CANDIDATES=50

# --- Chatbot RAG ---
# Similarité cosinus minimale pour répondre (calibrée pour multilingual-e5-small)
RAG_MIN_SCORE=0.83
RAG_SCORE_WINDOW=0.08

# --- Limitation de fréquence par utilisateur (0 = désactivé) ---
# chat : par minute ; quiz et résumés : par heure
RATE_LIMIT_CHAT=6
RATE_LIMIT_QUIZ=10
RATE_LIMIT_SUMMARY=10
